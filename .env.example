# Application database contract.
# The application only reads DATABASE_URL. Point it at either bundled Docker
# PostgreSQL or an externally managed PostgreSQL instance with pgvector enabled.

# Bundled Docker PostgreSQL defaults:
DATABASE_URL="postgresql://scout:scout_password@localhost:5432/scout"
APP_BASE_URL="http://localhost:3000"

# Logging. LOG_LEVEL: debug|info|warn|error (default: info in production, debug
# otherwise). LOG_FORMAT: json|pretty (default: json in production, pretty
# otherwise). Errors are written to stderr so PM2 splits them into *-error.log.
LOG_LEVEL=
LOG_FORMAT=

# Optional SMTP settings. If SMTP_HOST is omitted, activation emails are kept
# in email_outbox for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# File storage.
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage

# RAG retrieval tuning.
RAG_VECTOR_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RERANKER_TOP_K=8
RAG_VECTOR_WEIGHT=0.55
RAG_BM25_WEIGHT=0.45
RAG_RRF_K=60
RAG_MIN_FINAL_CHUNKS=5

# External PostgreSQL example:
# DATABASE_URL="postgresql://app_user:strong_password@db.example.com:5432/scout?sslmode=require"

# Docker Compose bundled database settings.
# These are consumed by docker-compose.yml, not by application code.
POSTGRES_DB=scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout_password
POSTGRES_PORT=5432

# Embeddable chatbot widget (the <script> on client sites) validates its API key
# against companyId / targetAppId / origin on /chat/query, /api/chatbot/*, and
# /api/guided-workflow-player/guides. Raise this for fewer DB round trips per
# chat message, at the cost of slower key-revocation propagation.
CHATBOT_EMBED_API_KEY_CACHE_TTL_MS=300000
# Secret used to sign the widget's short-lived guide-identifier tokens to make it obfuscated
CHATBOT_EMBED_ID_SECRET=

# Next.js proxy targets for detached APIs.
RECORDER_SYNC_API_URL=http://localhost:4301
SMART_FINDER_API_URL=http://localhost:4302
HTTP_TRIGGER_API_URL=http://localhost:4303

# Standalone runtime host/ports.
RECORDER_SYNC_API_HOST=0.0.0.0
RECORDER_SYNC_API_PORT=4301
SMART_FINDER_API_HOST=0.0.0.0
SMART_FINDER_API_PORT=4302
HTTP_TRIGGER_API_HOST=0.0.0.0
HTTP_TRIGGER_API_PORT=4303
ADMIN_SESSION_TIMEOUT_MINUTES=15
# Required shared secrets for private standalone service calls.
RECORDER_SYNC_INTERNAL_SECRET=kJ9ibWZelWl+5TMCP0BRPW28KesY+tecoF7nJa630jR1bab9ZyCMx1SdekzTsaMl
SMART_FINDER_INTERNAL_SECRET=DQf7v0o+xGdH7nTfbLxx6kv4TDuQ5u8Z7tTNpZyIwJ40Diw7vomAsUTgi4YrvOn+
# Shared secret the document worker uses to download Google Drive / SharePoint
# files via /api/internal/connector-file (must match on the app and worker).
DOCUMENT_WORKER_INTERNAL_SECRET=YaL0PoYMOu24Qmkqou3CXQMqlXpGg1ofoXRHfLPln4mQ+zkkBli7e+uRarYANJv7
# Used to sign pairing tokens for the Scout Web Ingestor.
WEB_INGESTION_TOKEN_SECRET=55hCZNRZ7+TnoY/SodndddyUDdYIjOL4Xo0i5wEZ29B6RDtGWDg/9QVGxOV2HUrc
# Stable encryption key for HTTP-trigger credentials. Keep this separate from
