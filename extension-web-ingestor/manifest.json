{
  "manifest_version": 3,
  "name": "Scout Web Ingestor",
  "version": "0.1.0",
  "description": "Capture web pages you are logged into and send them to Scout for knowledge-base ingestion.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scout Web Ingestor"
  }
}
